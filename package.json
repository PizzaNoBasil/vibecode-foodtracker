{
  "name": "vibecode-foodtracker",
  "private": true,
  "version": "1.0.0",
  "description": "Пет-проект на вайбкоде для подсчёта калорий и планирования питания",
  "type": "module",
  "scripts": {
    "data": "python3 -m planner build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s planner/tests -t .",
    "icons": "pwa-assets-generator --preset minimal-2023 public/icon.svg"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.2.0",
    "@phosphor-icons/react": "^2.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.4"
  }
}
